# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Without AWS_BUCKET, screenshots are only saved locally.

# AWS credentials (IAM user needs s3:PutObject on the bucket, and s3:GetObject on manifest.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Bucket the GC Replay viewer reads from
AWS_BUCKET=bookmap-logs
